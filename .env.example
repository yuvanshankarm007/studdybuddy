# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# DynamoDB Configuration
DYNAMODB_ENDPOINT_URL=http://localhost:8000
DYNAMODB_TABLE_PREFIX=StudyBuddy

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DAILY_STUDY_CAP_MINUTES=240
SLEEP_CUTOFF_HOUR=22

# Voice Settings
ENABLE_VOICE=true
TTS_ENGINE=gtts

# Wellness Data Provider (fitbit, apple_health, simulated)
WELLNESS_PROVIDER=simulated
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_client_secret

# Security
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Proactive Agent
ENABLE_PROACTIVE=true
CHECKIN_REMINDER_HOUR=19
SLEEP_REMINDER_HOUR=21
